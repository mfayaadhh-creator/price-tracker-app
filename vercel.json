{
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.go"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.go"
    },
    {
      "source": "/test-scrape",
      "destination": "/api/index.go"
    },
    {
      "source": "/((?!api/|healthz|test-scrape).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 0 * * *"
    }
  ]
}
