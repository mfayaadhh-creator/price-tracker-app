<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="tagGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF6D00" />
      <stop offset="100%" stop-color="#FF3D00" />
    </linearGradient>
  </defs>

  <!-- Dark Solid Container -->
  <rect width="512" height="512" rx="72" fill="#0C0E12" />
  <rect x="20" y="20" width="472" height="472" rx="56" fill="none" stroke="#232733" stroke-width="12" />

  <!-- Corner Status Dots -->
  <rect x="48" y="48" width="18" height="18" fill="#FF5722" />
  <rect x="446" y="48" width="18" height="18" fill="#00E676" />
  <rect x="48" y="446" width="18" height="18" fill="#232733" />
  <rect x="446" y="446" width="18" height="18" fill="#FF5722" />

  <!-- Main Brandmark: Geometric Price Tag Badge with Trend Drop Arrow -->
  <!-- Tag Body -->
  <path 
    d="M130 110 L280 110 L400 230 L260 370 L130 240 Z" 
    fill="url(#tagGrad)" 
    stroke="#FFFFFF" 
    stroke-width="16" 
    stroke-linejoin="miter" 
  />

  <!-- Tag Eyelet Circle -->
  <circle cx="205" cy="185" r="24" fill="#0C0E12" stroke="#FFFFFF" stroke-width="12" />

  <!-- Price Drop Trend Line & Arrow -->
  <path 
    d="M180 390 L260 390 L340 310 L390 310" 
    fill="none" 
    stroke="#00E676" 
    stroke-width="20" 
    stroke-linecap="square" 
    stroke-linejoin="miter" 
  />
  <polyline 
    points="340,390 390,390 390,340" 
    fill="none" 
    stroke="#00E676" 
    stroke-width="20" 
    stroke-linecap="square" 
    stroke-linejoin="miter" 
  />
</svg>
