<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="ptGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF6D00" />
      <stop offset="100%" stop-color="#FF3D00" />
    </linearGradient>
  </defs>
  <!-- Background Solid Square with subtle border -->
  <rect width="512" height="512" rx="64" fill="#0C0E12" />
  <rect x="16" y="16" width="480" height="480" rx="48" fill="none" stroke="#252A36" stroke-width="12" />
  
  <!-- Outer Corner Tech Dots -->
  <rect x="44" y="44" width="20" height="20" fill="#FF5722" />
  <rect x="448" y="44" width="20" height="20" fill="#FF5722" />
  <rect x="44" y="448" width="20" height="20" fill="#FF5722" />
  <rect x="448" y="448" width="20" height="20" fill="#00E676" />
  
  <!-- Inner Dynamic Lightning & Price Radar Symbol -->
  <path 
    d="M290 64 L130 276 L250 276 L222 448 L382 236 L262 236 Z" 
    fill="url(#ptGrad)" 
    stroke="#FFFFFF" 
    stroke-width="16" 
    stroke-linejoin="miter" 
  />
  
  <!-- Tech Accent Indicator -->
  <circle cx="370" cy="140" r="28" fill="#00E676" stroke="#0C0E12" stroke-width="8" />
</svg>
