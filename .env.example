# ==============================================================================
# PRICE_TRACKER v2.0 - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# 1. Server Configuration
PORT=8080

# 2. Database Connection (Supabase PostgreSQL Connection Pooler / Direct)
DATABASE_URL=postgres://postgres:your-supabase-db-password@your-db-host:5432/postgres?sslmode=require

# 3. Telegram Bot Configuration
# Token didapatkan dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 4. Optional: Telegram Webhook URL (Isi saat deploy di Vercel atau VPS dengan domain HTTPS)
# Kosongkan jika berjalan di localhost (sistem akan otomatis beralih ke Long-Polling)
# Example: https://price-tracker.vercel.app
WEBHOOK_URL=

# 5. Optional: Cron Security Secret (Mencegah endpoint cron dipicu oleh pihak luar)
# Example: a8f9c10e34b12d56...
CRON_SECRET=
